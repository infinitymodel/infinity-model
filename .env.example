# Public origin used for canonical links, Open Graph metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://infinity-model-sigma.vercel.app

# Public Salla storefront links. Change the store URL after shop.3dinfinitymodel.com is live.
NEXT_PUBLIC_SALLA_STORE_URL=https://3dinfinitymodel.com
NEXT_PUBLIC_SALLA_CUSTOM_SERVICE_URL=

# Salla Merchant API (server-only). Create an app/token with the products.read scope.
SALLA_ACCESS_TOKEN=

# Optional HTTPS webhook for quote requests and selected project files.
QUOTE_WEBHOOK_URL=

# Optional measurement configuration.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
